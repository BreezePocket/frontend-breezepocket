---
import Logo from './Logo.astro';
import PillButton from './PillButton.astro';
import { site } from '@/data/site';

interface Props {
  isHome: boolean;
}
const { isHome } = Astro.props;
---
<header class:list={[{ 'sub-page': !isHome }]}>
  <nav class="header__nav-left" aria-label="Primary">
    {site.nav.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>
  <div class="header__logo">
    <a href="/" class="header__logo_link" aria-label={`${site.name} Home`}><Logo /></a>
  </div>
  <nav class="header__nav-right" aria-label="Actions">
    <div class="header__ctas">
      <PillButton href={site.ctas.apply.href} variant="glass">{site.ctas.apply.label}</PillButton>
      <PillButton href={site.ctas.request.href} variant="dark">{site.ctas.request.label}</PillButton>
    </div>
    <button class="menu-btn" type="button" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-nav">
      <span class="menu-btn__icon">
        <span class="menu-btn__line menu-btn__line--1"></span>
        <span class="menu-btn__line menu-btn__line--2"></span>
        <span class="menu-btn__line menu-btn__line--3"></span>
      </span>
    </button>
  </nav>
  <nav class="mobile-nav" id="mobile-nav" aria-label="Mobile navigation">
    <div class="mobile-nav__panel-bg"></div>
    <div class="mobile-nav__panel">
      <div class="mobile-nav__header">
        <a href="/" class="mobile-nav__logo" aria-label={`${site.name} Home`}><Logo /></a>
        <button class="mobile-nav__close" type="button" aria-label="Close menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect y="14.1421" width="20" height="2" transform="rotate(-45 0 14.1421)" fill="currentColor"></rect>
            <rect x="1.41406" y="0.000610352" width="20" height="2" transform="rotate(45 1.41406 0.000610352)" fill="currentColor"></rect>
          </svg>
        </button>
      </div>
      <ul class="mobile-nav__list">
        {site.nav.map((link) => (
          <li class="mobile-nav__item"><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
      <div class="mobile-nav__ctas">
        <div class="mncta">
          <PillButton href={site.ctas.apply.href} variant="glass" class="mobile-nav__cta">{site.ctas.apply.label}</PillButton>
        </div>
        <div class="mncta">
          <PillButton href={site.ctas.request.href} variant="dark" class="mobile-nav__cta">{site.ctas.request.label}</PillButton>
        </div>
      </div>
    </div>
  </nav>
</header>
