---
import { site } from '@/data/site';
/** The wave emblem used by the page loader and the "bridge" section (animated via CSS/GSAP on the wrapper). */
interface Props {
  class?: string;
}
const { class: className = 'loader__logo' } = Astro.props;
const { mark } = site.logo;
---
<span class={className} aria-hidden="true">
  <img src={mark.src} width={mark.width} height={mark.height} alt="" class="loader__logo-img" decoding="async" />
</span>
