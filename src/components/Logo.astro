---
import { site } from '@/data/site';
/** BreezePocket logo. `variant` picks mark / wordmark / full lock-up; `white` uses the knocked-out version for dark surfaces. */
interface Props {
  variant?: 'full' | 'wordmark' | 'mark';
  white?: boolean;
  class?: string;
  alt?: string;
}
const { variant = 'full', white = false, class: className = 'logo', alt = site.name } = Astro.props;
const key = (variant + (white ? 'White' : '')) as keyof typeof site.logo;
const img = site.logo[key];
---
<img src={img.src} width={img.width} height={img.height} alt={alt} class={className} decoding="async" />
