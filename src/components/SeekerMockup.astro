---
/**
 * Seeker phone mockup showing the BreezePocket app screen.
 * Self-contained: fills its parent box (e.g. `.standards__image`) and scales
 * with the container width via `container-type: inline-size` + `cqw` units.
 * All dimensions are expressed as multiples of `--u` (1 unit = 1px on an
 * 800px-wide box), so the whole scene scales without JavaScript.
 */
const tiles = [
  { price: '$200', yield: '9.8%' },
  { price: '$225', yield: '11.1%' },
  { price: '$250', yield: '12.4%', selected: true },
  { price: '$275', yield: '13.6%' },
  { price: '$300', yield: '14.9%' },
  { price: '$350', yield: '17.2%' },
];
---

<div class="seeker">
  <p class="seeker__sr">
    Illustration of the BreezePocket app on a Solana Seeker phone. The screen shows a
    "Sell at" target grid for SOL, priced at $184.20, with $250 selected at an
    illustrative 12.4% yield for 10 SOL. Below $250 you keep your 10 SOL plus income;
    above $250 it is sold at $250 plus income. A "Start earning" button completes the screen.
  </p>

  <div class="seeker__stage" aria-hidden="true">
    <svg class="seeker__wave" viewBox="0 0 353 182" focusable="false">
      <path d="M14 96C70 40 160 8 250 14c40 3 75-2 98-8-18 46-73 80-143 78-65-2-125-10-191 12Z"/>
      <path d="M8 172c56-56 146-88 236-82 40 3 76-2 104-8-18 46-80 88-150 86-66-2-124-18-190 4Z"/>
    </svg>

    <div class="seeker__caption">
      <span class="seeker__pill">Coming to Seeker</span>
      <p class="seeker__line">Set a target from your pocket.</p>
      <p class="seeker__sub">Solana mobile, built in.</p>
    </div>

    <div class="phone">
      <span class="phone__btn phone__btn--vol"></span>
      <span class="phone__btn phone__btn--power"></span>
      <div class="phone__screen">
        <span class="phone__cam"></span>
        <div class="app">
          <div class="app__status">
            <span>9:41</span>
            <span class="app__status-icons"><i class="app__sig"></i><i class="app__bat"></i></span>
          </div>
          <div class="app__header">
            <img src="/brand/logo-mark.png" alt="" width="353" height="182" loading="lazy" decoding="async" />
            <span>BreezePocket</span>
          </div>
          <p class="app__headline">Earn while waiting to sell</p>
          <div class="app__asset"><i class="app__dot"></i><b>SOL</b><span>· $184.20</span></div>
          <div class="app__toggle"><span class="is-on">Sell at</span><span>Buy at</span></div>
          <div class="app__grid">
            {tiles.map((t) => (
              <div class:list={['tile', { 'tile--on': t.selected }]}>
                <b>{t.price}</b>
                <small>est. yield {t.yield}</small>
              </div>
            ))}
          </div>
          <p class="app__note">Illustrative yields</p>
          <div class="app__amount"><span>Amount</span><b>10 SOL</b></div>
          <div class="app__outcome">
            <p><i class="app__o app__o--keep"></i>Below $250 → keep 10 SOL + income</p>
            <p><i class="app__o app__o--sell"></i>Above $250 → sold at $250 + income</p>
          </div>
          <div class="app__cta">Start earning</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .seeker {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    container-type: inline-size;
    background: linear-gradient(135deg, #075ace 0%, #027bf6 48%, #13eafb 100%);
    color: #fcfcfc;
    font-family: 'Roboto', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .seeker__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .seeker__stage {
    --u: 0.125cqw;
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .seeker__stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgba(252, 252, 252, 0.22) calc(1.3 * var(--u)),
      transparent calc(1.9 * var(--u))
    );
    background-size: calc(28 * var(--u)) calc(28 * var(--u));
    background-position: calc(14 * var(--u)) calc(14 * var(--u));
  }
  .seeker__stage::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 78% 60%,
      rgba(252, 252, 252, 0.18),
      transparent 55%
    );
  }
  .seeker__wave {
    position: absolute;
    left: calc(-70 * var(--u));
    bottom: calc(-60 * var(--u));
    width: calc(640 * var(--u));
    height: auto;
    fill: #fcfcfc;
    opacity: 0.13;
  }

  /* Caption (desktop only) */
  .seeker__caption {
    position: absolute;
    z-index: 1;
    left: calc(56 * var(--u));
    top: 50%;
    transform: translateY(-50%);
    width: calc(370 * var(--u));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(14 * var(--u));
  }
  .seeker__pill {
    display: inline-flex;
    align-items: center;
    gap: calc(8 * var(--u));
    padding: calc(6 * var(--u)) calc(14 * var(--u));
    border-radius: 999px;
    border: calc(1 * var(--u)) solid rgba(252, 252, 252, 0.4);
    background: rgba(252, 252, 252, 0.14);
    font-size: calc(11.5 * var(--u));
    font-weight: 500;
    letter-spacing: calc(0.6 * var(--u));
    text-transform: uppercase;
    line-height: 1.2;
  }
  .seeker__pill::before {
    content: '';
    width: calc(7 * var(--u));
    height: calc(7 * var(--u));
    border-radius: 50%;
    background: #13eafb;
    box-shadow: 0 0 0 calc(3 * var(--u)) rgba(19, 234, 251, 0.3);
  }
  .seeker__line {
    margin: 0;
    font-size: calc(31 * var(--u));
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: calc(-0.7 * var(--u));
  }
  .seeker__sub {
    margin: 0;
    font-size: calc(17 * var(--u));
    line-height: 1.3;
    opacity: 0.82;
  }

  /* Phone */
  .phone {
    position: absolute;
    z-index: 2;
    left: calc(466 * var(--u));
    top: calc(24 * var(--u));
    width: calc(250 * var(--u));
    height: calc(540 * var(--u));
    box-sizing: border-box;
    padding: calc(8 * var(--u));
    border-radius: calc(40 * var(--u));
    background: #0b0f16;
    box-shadow:
      inset 0 0 0 calc(1.5 * var(--u)) #2b313c,
      0 calc(30 * var(--u)) calc(60 * var(--u)) rgba(4, 50, 115, 0.45),
      0 calc(4 * var(--u)) calc(12 * var(--u)) rgba(4, 50, 115, 0.3);
    transform: rotate(-6deg);
    transform-origin: 50% 0;
  }
  .phone__btn {
    position: absolute;
    right: calc(-3 * var(--u));
    width: calc(3 * var(--u));
    border-radius: 0 calc(2 * var(--u)) calc(2 * var(--u)) 0;
    background: #1b202a;
  }
  .phone__btn--vol {
    top: calc(118 * var(--u));
    height: calc(68 * var(--u));
  }
  .phone__btn--power {
    top: calc(206 * var(--u));
    height: calc(44 * var(--u));
  }
  .phone__screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(32 * var(--u));
    background: #fcfcfc;
    color: #043273;
  }
  .phone__cam {
    position: absolute;
    z-index: 2;
    top: calc(9 * var(--u));
    left: 50%;
    width: calc(11 * var(--u));
    height: calc(11 * var(--u));
    transform: translateX(-50%);
    border-radius: 50%;
    background: #0b0f16;
    box-shadow: inset 0 0 0 calc(2 * var(--u)) #1e2530;
  }

  /* App screen */
  .app {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    padding: calc(8 * var(--u)) calc(13 * var(--u)) calc(14 * var(--u));
    font-size: calc(11 * var(--u));
    line-height: 1.25;
  }
  .app p {
    margin: 0;
  }
  .app__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: calc(14 * var(--u));
    padding: 0 calc(6 * var(--u));
    font-size: calc(9.5 * var(--u));
    font-weight: 500;
  }
  .app__status-icons {
    display: flex;
    align-items: center;
    gap: calc(4 * var(--u));
  }
  .app__sig {
    display: block;
    width: calc(13 * var(--u));
    height: calc(9 * var(--u));
    background: linear-gradient(
      to right,
      #043273 0 19%, transparent 19% 27%,
      #043273 27% 46%, transparent 46% 54%,
      #043273 54% 73%, transparent 73% 81%,
      #043273 81% 100%
    );
    clip-path: polygon(0 62%, 100% 0, 100% 100%, 0 100%);
  }
  .app__bat {
    display: block;
    box-sizing: border-box;
    width: calc(18 * var(--u));
    height: calc(9 * var(--u));
    padding: calc(1.4 * var(--u));
    border: calc(1.2 * var(--u)) solid #043273;
    border-radius: calc(2.5 * var(--u));
    background: linear-gradient(to right, #043273 0 74%, transparent 74%) content-box;
  }
  .app__header {
    display: flex;
    align-items: center;
    gap: calc(7 * var(--u));
    font-size: calc(13 * var(--u));
    font-weight: 600;
    letter-spacing: calc(-0.2 * var(--u));
  }
  .app__header img {
    width: calc(24 * var(--u));
    height: calc(12.4 * var(--u));
    object-fit: contain;
    display: block;
  }
  .app__headline {
    font-size: calc(17.5 * var(--u));
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: calc(-0.4 * var(--u));
  }
  .app__asset {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: calc(6 * var(--u));
    padding: calc(4.5 * var(--u)) calc(10 * var(--u));
    border-radius: 999px;
    background: #eaf3f9;
    font-size: calc(10.5 * var(--u));
    color: #4a6a8f;
  }
  .app__asset b {
    color: #043273;
    font-weight: 600;
  }
  .app__dot {
    display: block;
    width: calc(8 * var(--u));
    height: calc(8 * var(--u));
    border-radius: 50%;
    background: #9945ff;
  }
  .app__toggle {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: calc(3 * var(--u));
    border-radius: 999px;
    background: #eaf3f9;
    font-size: calc(10.5 * var(--u));
    font-weight: 500;
    color: #4a6a8f;
    text-align: center;
  }
  .app__toggle span {
    padding: calc(4.5 * var(--u)) 0;
    border-radius: 999px;
  }
  .app__toggle .is-on {
    background: #fcfcfc;
    color: #043273;
    box-shadow: 0 calc(1 * var(--u)) calc(3 * var(--u)) rgba(4, 50, 115, 0.16);
  }
  .app__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: calc(6 * var(--u));
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: calc(2 * var(--u));
    padding: calc(6.5 * var(--u)) calc(6 * var(--u));
    border: calc(1.2 * var(--u)) solid #d0e1eb;
    border-radius: calc(10 * var(--u));
    background: #fcfcfc;
  }
  .tile b {
    font-size: calc(12.5 * var(--u));
    font-weight: 600;
    letter-spacing: calc(-0.2 * var(--u));
  }
  .tile small {
    font-size: calc(7.4 * var(--u));
    line-height: 1.2;
    color: #4a6a8f;
    white-space: nowrap;
  }
  .tile--on {
    border-color: #027bf6;
    background: #027bf6;
    color: #fcfcfc;
    box-shadow: 0 calc(4 * var(--u)) calc(10 * var(--u)) rgba(2, 123, 246, 0.35);
  }
  .tile--on small {
    color: rgba(252, 252, 252, 0.85);
  }
  .app__note {
    margin-top: calc(-3 * var(--u)) !important;
    font-size: calc(7.4 * var(--u));
    color: #4a6a8f;
    text-align: center;
  }
  .app__amount {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(6.5 * var(--u)) calc(10 * var(--u));
    border: calc(1.2 * var(--u)) solid #d0e1eb;
    border-radius: calc(10 * var(--u));
    font-size: calc(10 * var(--u));
    color: #4a6a8f;
  }
  .app__amount b {
    font-size: calc(12 * var(--u));
    font-weight: 600;
    color: #043273;
  }
  .app__outcome {
    display: flex;
    flex-direction: column;
    gap: calc(4 * var(--u));
    padding: calc(7 * var(--u)) calc(10 * var(--u));
    border-radius: calc(10 * var(--u));
    background: #eaf3f9;
    font-size: calc(8.6 * var(--u));
    color: #043273;
  }
  .app__outcome p {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
    white-space: nowrap;
  }
  .app__o {
    flex: none;
    display: block;
    width: calc(6 * var(--u));
    height: calc(6 * var(--u));
    border-radius: 50%;
  }
  .app__o--keep {
    background: #2fd6c9;
  }
  .app__o--sell {
    background: #ff4d67;
  }
  .app__cta {
    padding: calc(9.5 * var(--u));
    border-radius: 999px;
    background: #043273;
    color: #fcfcfc;
    text-align: center;
    font-size: calc(11.5 * var(--u));
    font-weight: 600;
  }

  /* Narrow boxes: hide the caption, centre and enlarge the phone (cropped at the bottom). */
  @container (max-width: 600px) {
    .seeker__stage {
      --u: 0.2cqw;
    }
    .seeker__caption {
      display: none;
    }
    .phone {
      left: calc(125 * var(--u));
      top: calc(14 * var(--u));
    }
    .seeker__wave {
      left: calc(-120 * var(--u));
      bottom: calc(-40 * var(--u));
      width: calc(560 * var(--u));
    }
  }
  @container (max-width: 420px) {
    .seeker__stage {
      --u: 0.25cqw;
    }
    .phone {
      left: calc(75 * var(--u));
    }
  }
</style>
