---
import Base from '@/layouts/Base.astro';
import MissionBridge from '@/components/MissionBridge.astro';
---
<Base page="not-found" title="Page Not Found" description="This page does not exist or has been moved." noindex>
  <MissionBridge headingLevel="h1" show lines={["We couldn't find", 'the page you', 'were looking for.']} text="The page may have moved or no longer exists.<br> Head back home or learn more about our mission." ctas={[{ label: 'Back to Home', href: '/', variant: 'glass' }, { label: 'Our Mission', href: '/our-mission', variant: 'dark' }]} />
</Base>
