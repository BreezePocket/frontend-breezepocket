---
import '@/styles/pages/apply.css';
import Base from '@/layouts/Base.astro';
import SubHero from '@/components/SubHero.astro';
import CtaSection from '@/components/CtaSection.astro';
import PillButton from '@/components/PillButton.astro';
import { applyHero, applySections, applyCta, tradeOptions, experienceOptions, applyModal } from '@/data/apply';

const TOTAL_STEPS = 5;
const steps = [
  { n: 1, title: applyModal.steps.details },
  { n: 2, title: applyModal.steps.trade },
  { n: 3, title: applyModal.steps.experience },
  { n: 4, title: applyModal.steps.credentials },
  { n: 5, title: applyModal.steps.review },
];
---
<Base page="apply" title="Apply" description="Join Vectr - Great projects rely on great people.">
  <div class="apply">
    <SubHero title={applyHero.title} text={applyHero.text}>
      <div class="flx sub-hero__cta">
        <PillButton variant="dark" data-apply-trigger="true">{applyHero.cta}</PillButton>
      </div>
    </SubHero>

    <div class="apply-sections sticky-stack">
      {applySections.map((section) => (
        <div class="apply-section-wrapper sticky-stack__item">
          <section class="apply-section">
            <div class="apply-section__side">
              <h2 class="apply-section__title">{section.title}</h2>
            </div>
            <div class="apply-section__content">
              <p class="apply-section__text">{section.text}</p>
              <div class="apply-section__image">
                <img
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                  loading="lazy"
                  decoding="async"
                  class="apply-section__img"
                />
              </div>
            </div>
            <div class="apply-section__overlay" aria-hidden="true"></div>
          </section>
        </div>
      ))}
    </div>

    <CtaSection lines={applyCta.lines} subtitle={applyCta.subtitle}>
      <PillButton variant="light" data-apply-trigger="true">{applyCta.label}</PillButton>
    </CtaSection>
  </div>

  <div class="apply-modal" role="dialog" aria-modal="true" aria-labelledby="apply-modal-title-1" data-lenis-prevent tabindex="-1">
    <div class="apply-modal__overlay"></div>
    <div class="apply-modal__container">
      <div class="modal-steps-wrapper">
        {steps.map((step) => (
          <div class:list={['modal-card apply-modal__card modal-step', { 'modal-step--active': step.n === 1 }]} data-modal-step={step.n}>
            <div class="modal-nav">
              <button class="modal-nav__arrow modal-nav__arrow--prev" type="button" aria-label="Previous step" disabled={step.n === 1} data-modal-prev>
                <svg width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M7 0.707031L1.00034 6.70737L7 12.707" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
                </svg>
              </button>
              <span class="modal-nav__counter">{step.n} of {TOTAL_STEPS}</span>
              <button class="modal-nav__arrow modal-nav__arrow--next" type="button" aria-label="Next step" disabled={step.n === TOTAL_STEPS} data-modal-next>
                <svg width="8" height="14" viewBox="0 0 8 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M1 0.707031L6.99966 6.70737L1 12.707" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
                </svg>
              </button>
            </div>
            <h3 class="apply-modal__title" id={`apply-modal-title-${step.n}`}>{step.title}</h3>

            {step.n === 1 && (
              <div class="form apply-modal__form">
                <div class="form__field">
                  <label class="form__label" for="fullName">Full Name <span class="form__required"> *</span></label>
                  <input type="text" id="fullName" name="fullName" class="form__input" placeholder="Your Name" required autocomplete="name" data-error-message={applyModal.errors.fullName} />
                  <span class="form__error" data-field-error aria-live="polite"></span>
                </div>
                <div class="form__field">
                  <label class="form__label" for="email">Email <span class="form__required"> *</span></label>
                  <input type="email" id="email" name="email" class="form__input" placeholder="your@email.com" required autocomplete="email" data-error-message={applyModal.errors.email} />
                  <span class="form__error" data-field-error aria-live="polite"></span>
                </div>
                <div class="form__field">
                  <label class="form__label" for="phone">Contact Number</label>
                  <input type="tel" id="phone" name="phone" class="form__input" placeholder="+1" autocomplete="tel" data-error-message />
                  <span class="form__error" data-field-error aria-live="polite"></span>
                </div>
              </div>
            )}

            {step.n === 2 && (
              <>
                <div class="form__checkbox-grid" role="group" aria-labelledby="apply-modal-title-2">
                  {tradeOptions.map((opt) => (
                    <label class="form__checkbox">
                      <input type="checkbox" name="trade" value={opt.value} />
                      <span class="form__checkbox-icon">
                        <svg width="12" height="10" viewBox="0 0 12 10" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                          <path d="M1 5L4.5 8.5L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        </svg>
                      </span>
                      <span class="form__checkbox-label">{opt.label}</span>
                    </label>
                  ))}
                </div>
                <p class="form__error apply-modal__step-error" data-step-error aria-live="polite"></p>
              </>
            )}

            {step.n === 3 && (
              <>
                <div class="form__radio-card-grid" role="radiogroup" aria-labelledby="apply-modal-title-3">
                  {experienceOptions.map((opt) => (
                    <label class="form__radio-card">
                      <input type="radio" name="experience" value={opt.value} />
                      <span>{opt.label}</span>
                    </label>
                  ))}
                </div>
                <p class="form__error apply-modal__step-error" data-step-error aria-live="polite"></p>
              </>
            )}

            {step.n === 4 && (
              <div class="form apply-modal__form">
                <div class="form__field form__file-field" data-file-upload data-max-size={applyModal.maxFileSize} data-too-large-message={applyModal.errors.fileTooLarge}>
                  <label class="form__label" for="resume">Upload your resume (optional)</label>
                  <label class="form__file-upload" for="resume" data-file-empty>
                    <span class="form__file-upload-text">Upload</span>
                    <svg width="16" height="15" viewBox="0 0 16 15" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M2 13.0005H14V10.0005H16V14.0005C15.9999 14.5527 15.5522 15.0005 15 15.0005H1C0.447783 15.0005 0.00010925 14.5527 0 14.0005V10.0005H2V13.0005ZM7.36816 0.224121C7.76085 -0.0963307 8.34083 -0.0734614 8.70703 0.29248L14.707 6.29248L13.293 7.70654L9 3.41357V11.0005H7V3.41357L2.70703 7.70654L1.29297 6.29248L7.29297 0.29248L7.36816 0.224121Z" fill="#050419"></path>
                    </svg>
                    <input type="file" id="resume" name="resume" accept=".pdf,.doc,.docx" class="form__file-input" />
                  </label>
                  <div class="form__file-loading" data-file-loading hidden>
                    <span class="form__file-spinner" aria-hidden="true"></span>
                    <span class="form__file-loading-text">Uploading…</span>
                  </div>
                  <p class="form__error" data-file-error aria-live="polite"></p>
                  <div class="form__file-filled" data-file-filled hidden>
                    <span class="form__file-filled-name" data-file-name></span>
                    <button type="button" class="form__file-remove" data-file-remove aria-label="Remove file">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M1 1L11 11M11 1L1 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
                      </svg>
                    </button>
                  </div>
                </div>
                <div class="form__field">
                  <label class="form__label" for="certifications">List your key certifications (optional)</label>
                  <textarea id="certifications" name="certifications" class="form__textarea" placeholder="Type your key certifications here" rows="4"></textarea>
                </div>
              </div>
            )}

            {step.n === 5 && (
              <>
                <div class="review-summary">
                  <div class="review-summary__item" data-review-section="contact">
                    <h4>Contact Details</h4>
                    <div class="review-summary__content" data-review-contact></div>
                  </div>
                  <div class="review-summary__item" data-review-section="trade">
                    <h4>Primary Trade &amp; Specialty</h4>
                    <div class="review-summary__content" data-review-trade></div>
                  </div>
                  <div class="review-summary__item" data-review-section="experience">
                    <h4>Experience Level</h4>
                    <div class="review-summary__content" data-review-experience></div>
                  </div>
                  <div class="review-summary__item" data-review-section="credentials">
                    <h4>Your Credentials</h4>
                    <div class="review-summary__content" data-review-credentials></div>
                  </div>
                </div>
                <div class="form__disclaimer-wrap">
                  <p class="form__disclaimer">{applyModal.disclaimer}<a href="/privacy">Privacy Policy</a>.</p>
                  <details class="form__disclaimer-details">
                    <summary>Read more</summary>
                    <span>{applyModal.disclaimerDetails}</span>
                  </details>
                </div>
                <p class="form__error apply-modal__step-error" data-modal-error aria-live="assertive"></p>
                <button type="submit" class="pill-btn pill-btn--dark w-100" data-modal-submit="true">
                  <span class="pill-btn-span">Submit</span>
                </button>
              </>
            )}
          </div>
        ))}

        <div class="apply-modal__card modal-card modal-success" data-modal-success>
          <h3 class="modal-success__title" id="apply-modal-title-success" data-success-title data-success-template={applyModal.success.title}>{applyModal.success.title}</h3>
          <p class="modal-success__body">{applyModal.success.body}</p>
          <div class="modal-success__cta">
            <div class="flx">
              <a href="/" class="pill-btn pill-btn--dark w-100" data-success-home="true">
                <span class="pill-btn-span">{applyModal.success.home}</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <button class="apply-modal__close" type="button" data-modal-close>
      <span>Close</span>
      <div class="am-close-line"></div>
    </button>
  </div>
</Base>
