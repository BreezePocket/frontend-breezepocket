---
import Base from '@/layouts/Base.astro';
import SubHero from '@/components/SubHero.astro';
import SubHeroImage from '@/components/SubHeroImage.astro';
import CtaSection from '@/components/CtaSection.astro';
import { industries, industriesPage } from '@/data/industries';
// Imported after Base so the page rules follow the shared stylesheets in the bundle
// (`.industry-row-wrapper { position: sticky }` must beat `.sticky-stack__item { position: relative }`).
import '@/styles/pages/industries.css';

const { hero, heroImage, sectionTitle, cta } = industriesPage;
---
<Base page="industries" title="Our Industries" description="Discover the industries we serve with AI driven precision staffing for critical outages.">
  <div class="industries">
    <SubHero title={hero.title} text={hero.text} scrollButton />
    <SubHeroImage src={heroImage.src} alt={heroImage.alt} width={heroImage.width} height={heroImage.height} />
    <h2 class="industries-title">{sectionTitle}</h2>
    <section class="industry-section sticky-stack">
      {industries.map((industry) => (
        <div class="industry-row-wrapper sticky-stack__item">
          <div id={industry.id} class="industry-row">
            <div class="industry-row__nav">
              <nav class="industry-nav" aria-label="Industry navigation">
                {industries.map((item) => (
                  <a
                    href={`#${item.id}`}
                    class:list={['industry-nav__item', { 'is-active': item.id === industry.id }]}
                    data-target={item.id}
                  >
                    {item.navLabel}
                  </a>
                ))}
              </nav>
            </div>
            <div class="industry-row__card">
              <article class="industry-card flx-column">
                <div class="industry-card__image">
                  <img
                    src={industry.image.src}
                    alt={industry.image.alt}
                    width={industry.image.width}
                    height={industry.image.height}
                    loading="lazy"
                    decoding="async"
                    class="industry-card__img"
                  />
                </div>
                <h3 class="industry-card__title">{industry.title}</h3>
                <ul class="industry-card__services">
                  {industry.services.map((service) => (
                    <>
                      <li class="industry-card__service">{service}</li>
                      <div class="industry-card__divider"></div>
                    </>
                  ))}
                </ul>
              </article>
            </div>
            <div class="industry-row__overlay" aria-hidden="true"></div>
          </div>
        </div>
      ))}
    </section>
    <CtaSection lines={cta.lines} href={cta.href} label={cta.label} />
  </div>
</Base>
