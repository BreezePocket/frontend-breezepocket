---
import '@/styles/pages/privacy.css';
import Base from '@/layouts/Base.astro';
import LegalLayout from '@/components/LegalLayout.astro';
import { privacyMeta, privacySections } from '@/data/privacy';
---
<Base page="privacy" title="Privacy Policy" description="Learn how BreezePocket collects, uses, and protects your personal information, including waitlist details and wallet addresses.">
  <LegalLayout
    title={privacyMeta.heroTitle}
    text={privacyMeta.heroText}
    navLabel={privacyMeta.navLabel}
    updated={privacyMeta.updated}
    sections={privacySections}
    contactEmail={privacyMeta.contactEmail}
  />
</Base>
